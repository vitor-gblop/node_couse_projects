<div class="container">
  <form action="/toughts/create" method="post">
    <h2>Ciar pensamento</h2>
    <br>
    <div class="form-group">
        <label for="title">Pensamento:</label>
      <input type="text" name="title" placeholder="Seu pensamento" />
