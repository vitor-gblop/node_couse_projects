<div>
  <div class="title-container">
    <h1>Inicio</h1>
  </div>
  <div>
    <h2>Todos os Pensamentos</h2>
    <form class="search-bar-container" method="get" action="/">
      <input type="text" name="search" />
      <button type="submit">Buscar</button>
    </form>
    <br />
    <div>
      <p>Encontrados {{qtdResults}} resultados</p>
      {{#if empty}}
        <p>Sem pensamentos ainda</p>
      {{/if}}
      <div class="opt-container" style="align-items: center;">
        ordernar por:
        <form action="/">
          <input type="hidden" name="order" value="DESC" />
          <input type="submit" value="Decr." />
        </form>
        -
        <form action="/">
          <input type="hidden" name="order" value="ASC" />
          <input type="submit" value="Cres." />
        </form>
      </div>
      <br>

      <div>
        {{#each toughts}}
          <div id="" class="tought">
            <h2>"{{this.title}}"</h2>
            <p> por {{this.user.dataValues.name}} </p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>